# ========================================
# .gitignore - Arquivos que NAO devem ir para o GitHub
# ========================================

# Dependencias
node_modules/
bower_components/
jspm_packages/
package-lock.json
yarn.lock

# Arquivos de ambiente (NUNCA versionar senhas!)
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
.firebase/

# Firebase
.firebaserc
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
firebase-debug.*.log

# Build / Dist
dist/
build/
out/
.next/
.nuxt/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testes
coverage/
.nyc_output/
*.lcov
.grunt

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Arquivos temporarios
*.tmp
*.temp
*.bak
*.cache

# Scripts locais (se quiser manter scripts privados)
# scripts/*.local.bat
# scripts/*.local.sh

# Certificados e chaves (IMPORTANTE!)
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Bancos de dados locais
*.sqlite
*.db

# Backups
*.backup
*.old

# Arquivos grandes de midia (opcional)
# *.mp4
# *.mov
# *.avi

# Uploads de usuarios (se aplicavel)
# uploads/
# public/uploads/
nul 
